<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!--
      ConnectLens backup rules.
      We allow backing up DataStore preferences (onboarding state).
      We exclude the Room database since it is a cache of system data
      that will be re-populated on next launch.
    -->
    <exclude domain="database" path="connectlens.db" />
    <exclude domain="database" path="connectlens.db-shm" />
    <exclude domain="database" path="connectlens.db-wal" />
</full-backup-content>
